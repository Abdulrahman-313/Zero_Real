# Copy to .env.local and fill in. Never commit .env.local.

# --- Authentication (Clerk) ---
# Create a free application at https://dashboard.clerk.com and copy its API keys.
# Publishable key is safe for the browser; the secret key must stay server-side.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Where Clerk's sign-in / sign-up flows live in this app (defaults are fine).
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# --- AI (Google Gemini) ---
# Free API key from Google AI Studio: https://aistudio.google.com/apikey
# Leave empty to run with the built-in rule-based fallback (no network calls).
GEMINI_API_KEY=

# Free-tier eligible Gemini model. Alternatives: gemini-3.8-flash, gemini-3.1-flash-lite
GEMINI_MODEL=gemini-3.5-flash-lite
